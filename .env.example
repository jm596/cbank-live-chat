# Copy this file to .env and fill in your real SMTP credentials.
# Without these, the server still runs fine — it just skips sending
# transcript emails and marks them "not-configured" in the agent dashboard.

# Any SMTP provider works: your email host, Gmail (with an App Password,
# not your regular password), SendGrid, Postmark, Mailgun, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Optional: overrides the "From" name/address on transcript emails.
# Defaults to "cbank Support" <SMTP_USER> if omitted.
MAIL_FROM="cbank Support" <support@cbank.example>

# Port the server listens on (Railway/Render set this automatically).
PORT=3000

# ---- WhatsApp Business (Meta Cloud API) ----------------------------------
# Without these, the server still runs fine — incoming WhatsApp messages
# (once you have a real number) would just log a warning and not reply.
# Get these from Meta for Developers → your app → WhatsApp → API Setup:
#   - WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_BUSINESS_ACCOUNT_ID: shown right
#     on that page next to your test (or real) number.
#   - WHATSAPP_ACCESS_TOKEN: the token generated there (temporary, ~1-2h) or
#     via Tools → Graph API Explorer → Generate Access Token with the
#     whatsapp_business_management + whatsapp_business_messaging permissions.
#     For production, generate a permanent System User token instead — see
#     README.md "Going to production".
#   - WHATSAPP_VERIFY_TOKEN: any string you make up yourself. Enter the same
#     value here and in the webhook config on Meta's side (Configuration →
#     Webhook → Verify token) — it's just a shared secret for the handshake.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0

# ---- Instagram Messaging (Instagram API with Instagram Login, Page-less) -
# Without these, the server still runs fine — incoming Instagram DMs would
# just log a warning and not reply.
# Prerequisites (do this in Meta for Developers):
#   1. In your Meta App, add the "Instagram > API setup with Instagram
#      login" use case (no linked Facebook Page needed) and add the
#      instagram_business_basic, instagram_business_manage_messages and
#      instagram_business_manage_comments permissions.
#   2. Add @cbankcard as an "Instagram Tester" (Roles tab) and accept the
#      invite from the account itself at
#      instagram.com/accounts/manage_access/ → "Invitaciones de prueba".
#   3. Authorize via https://www.instagram.com/oauth/authorize?client_id=<IG_APP_ID>&redirect_uri=<REDIRECT_URI>&response_type=code&scope=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
#      then exchange the returned code at api.instagram.com/oauth/access_token
#      for a short-lived token, and that for a long-lived one (60 days) at
#      graph.instagram.com/access_token?grant_type=ig_exchange_token — see
#      README.md "Going to production". Long-lived tokens must be refreshed
#      before they expire (graph.instagram.com/refresh_access_token).
#   4. Set INSTAGRAM_ACCESS_TOKEN to that long-lived token.
#   5. Set the webhook URL to https://<your-domain>/webhooks/instagram in
#      the App's Webhooks config, subscribe to the "messages" field under
#      the Instagram object, and enter the same INSTAGRAM_VERIFY_TOKEN below
#      and on Meta's side (it's just a shared secret for the handshake).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v22.0
